---
import Arquivo from '../../layouts/Arquivo.astro';
import {posts, renderMarkdown, dateLabel, authorPath, themePath, yearPath, labelYear} from '../../acervo.mjs';
export function getStaticPaths() {
  return posts.map(post => ({params:{id:post.id},props:{post}}));
}
const {post} = Astro.props;
const base = import.meta.env.BASE_URL;
const body = renderMarkdown(post.body, base);
const comments = renderMarkdown(post.comments, base, {comments:true,postId:post.id});
---
<Arquivo title={post.title}>
  <article class="quadro">
    <p class="eyebrow"><a href={yearPath(post.year,base)}>{labelYear(post.year)}</a> / #{post.id}</p>
    <h1>{post.title}</h1>
    <p class="minor"><time datetime={post.date || undefined}>{dateLabel(post.date)}</time>{post.author && <> · <a rel="author" href={authorPath(post.author,base)}>{post.author}</a></>}</p>
    {post.themes.length > 0 && <p class="minor">{post.themes.map((name,i) => <>{i > 0 && ' · '}<a href={themePath(name,base)}>{name}</a></>)}</p>}
    {post.catalogOnly ? <p>Esta página registra o título e a data da publicação original. O texto e os comentários ainda não fazem parte da edição web.</p> : <div class="prosa" set:html={body} />}
    {comments && <section class="comentarios"><h2>Comentários</h2><div class="prosa" set:html={comments} /></section>}
  </article>
</Arquivo>
