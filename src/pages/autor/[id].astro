---
import Arquivo from '../../layouts/Arquivo.astro';
import Lista from '../../components/Lista.astro';
import {posts, pageKey} from '../../acervo.mjs';
export function getStaticPaths() {
  const authors = [...new Set(posts.map(post => post.author).filter(Boolean))];
  return authors.map(name => ({params:{id:pageKey(name)},props:{name,entries:posts.filter(post => post.author === name)}}));
}
const {name,entries} = Astro.props;
---
<Arquivo title={name}>
<h1>{name}</h1>
<Lista entries={entries} />
</Arquivo>
