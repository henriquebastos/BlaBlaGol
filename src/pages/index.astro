---
import Arquivo from '../layouts/Arquivo.astro';
import Lista from '../components/Lista.astro';
import {posts, years, labelYear, yearPath} from '../acervo.mjs';
const base = import.meta.env.BASE_URL;
---
<Arquivo title="BlaBlaGol">
  <h1>Últimos posts</h1>
  <Lista entries={posts.slice(0,40)} />
  <h2>Por ano</h2>
  <ul class="anual">{years.map(year => <li><a href={yearPath(year,base)}>{labelYear(year)}</a></li>)}</ul>
</Arquivo>
